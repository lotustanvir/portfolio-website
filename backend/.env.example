# ─────────────────────────────────────────────────
# Environment Variables — Portfolio Backend
# ─────────────────────────────────────────────────
# Copy this file to .env and replace the values.

NODE_ENV=development
PORT=4000

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/database_name?schema=public"

# CORS
CORS_ORIGIN="http://localhost:3000"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
THROTTLE_WINDOW_MS=60000
THROTTLE_MAX_REQUESTS=10

# Logging
LOG_LEVEL=debug
LOG_FILE=src/logs/app.log
ERROR_LOG_FILE=src/logs/error.log

# Security
COOKIE_SECRET=change-this-to-a-random-secret
COOKIE_MAX_AGE=604800000

# JWT (placeholder for Phase 3)
JWT_SECRET=change-this-to-a-random-secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Bcrypt (placeholder for Phase 3)
BCRYPT_SALT_ROUNDS=12
